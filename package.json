{
  "name": "scientia-db",
  "version": "0.0.0",
  "private": true,
  "description": "Declarative database lifecycle framework: provision, connect, migrate, observe.",
  "type": "module",
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "packages/*",
    "packages/provisioners/*",
    "packages/connectors/*"
  ],
  "scripts": {
    "build": "pnpm -r --filter \"./packages/**\" run build",
    "typecheck": "pnpm -r --filter \"./packages/**\" run typecheck",
    "clean": "pnpm -r exec rimraf dist *.tsbuildinfo",
    "format": "prettier --write \"**/*.{ts,json,md,yaml}\""
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "prettier": "^3.3.0",
    "rimraf": "^5.0.0",
    "typescript": "^5.5.0"
  }
}
