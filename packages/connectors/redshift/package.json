{
  "name": "@foundry/connector-redshift",
  "version": "0.0.0",
  "description": "Redshift connector for foundry — pg.Pool wrapper over the Postgres wire protocol",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "clean": "rimraf -g dist *.tsbuildinfo",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@aws-sdk/client-secrets-manager": "^3.600.0",
    "pg": "^8.13.0"
  },
  "peerDependencies": {
    "@foundry/core": "*"
  },
  "devDependencies": {
    "@types/pg": "^8.11.0",
    "aws-sdk-client-mock": "^4.0.0",
    "typescript": "^5.5.0",
    "vitest": "^2.1.0"
  }
}
