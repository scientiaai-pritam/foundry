{
  "name": "@scientia/aws-redshift",
  "version": "0.0.0",
  "description": "scientia-db provisioner for AWS Redshift clusters (CreateCluster + node type + node count + VPC/security-group wiring).",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "clean": "rimraf dist *.tsbuildinfo",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@aws-sdk/client-redshift": "^3.658.0",
    "@scientia/core": "*"
  },
  "devDependencies": {
    "@aws-sdk/client-redshift": "^3.658.0",
    "@scientia/core": "*",
    "aws-sdk-client-mock": "^4.1.0",
    "typescript": "^5.5.0",
    "vitest": "^2.1.0"
  }
}
