{
  "name": "@scientia/supabase-postgres",
  "version": "0.0.0",
  "description": "Supabase Postgres provisioner for scientia (non-AWS, REST + global fetch).",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rimraf -g dist *.tsbuildinfo"
  },
  "peerDependencies": {
    "@scientia/core": "*"
  },
  "devDependencies": {
    "@scientia/core": "*",
    "@types/node": "^22.7.0",
    "typescript": "^5.5.0",
    "vitest": "^2.1.0"
  }
}
